+void f_hook_proto_call() {
+  int const num_arg = st_num_arg;
+  svalue_t* arg = sp - num_arg + 1;
+  int const flags = arg[0].u.number;
+  int const budget = arg[1].u.number;
+  funptr_t* f = arg[2].u.fp;
+  int stale = 0;
+  svalue_t* ret = hook_proto_run(f, num_arg - 3, flags, budget, &stale);
+  array_t* v = allocate_empty_array(ret ? 2 : 3);
+  if (ret) {
+    assign_svalue_no_free(&v->item[0], ret);
+  } else {
+    v->item[0] = const0;
+    v->item[2] = const1;
+  }
+  v->item[1].type = T_NUMBER;
+  v->item[1].subtype = 0;
+  v->item[1].u.number = stale;
+  pop_3_elems();
+  push_refed_array(v);
+}
+#endif
