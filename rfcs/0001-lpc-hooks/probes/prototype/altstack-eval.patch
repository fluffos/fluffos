+// ===========================================================================
+// Hook prototype (RFC 0001 validation, not for merge)
+//   flags: 1 = run the handler on an alternate VM stack
+//          2 = whole-stack walkers also visit suspended stacks
+//          4 = handler exempt from the caller's eval limit (lazy credit)
+//          8 = cap the uncharged time per evaluation at budget_us
+//         16 = eager variant: get_eval + 2x set_eval around the handler
+// ===========================================================================
+#include <chrono>
+#ifdef __linux__
+#include "vm/internal/posix_timers.h"
+#endif
+#include "vm/internal/eval_limit.h"
+
+namespace {
+constexpr int kAltStackSize = 4096;
+constexpr int kAltDepth = 64;
+svalue_t _alt_stack[10 + kAltStackSize + 10];
+control_stack_t _alt_cstack[5 + kAltDepth + 5];
+
+struct SuspendedStack {
+  svalue_t *start, *sp, *end;
+  control_stack_t *cbase, *csp, *clast;
+  SuspendedStack* next;
+};
+SuspendedStack* g_suspended = nullptr;
+int g_proto_walk_all = 0;
+bool g_in_alt = false;
+
+std::chrono::steady_clock::time_point g_hook_t0;
+int64_t g_hook_budget_us = 0;
+int64_t g_hook_caller_R = -1;
+
+int64_t us_since(std::chrono::steady_clock::time_point t0) {
+  return std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - t0)
+      .count();
+}
+void raw_timer_set(int64_t us) {
+#ifdef __linux__
+  posix_eval_timer_set(us > 0 ? us : 1);
+#endif
+  outoftime = 0;
+}
+}  // namespace
+
+int g_hook_exempt = 0;
+extern int64_t g_eval_credit;
+extern int64_t g_hook_allow_used;
+
+static void hook_proto_sweep_suspended(object_t* ob) {
+  if (!g_proto_walk_all) return;
+  for (SuspendedStack* s = g_suspended; s; s = s->next) {
+    for (svalue_t* svp = s->start; svp <= s->sp; svp++) {
+      if (svp->type == T_OBJECT && svp->u.ob == ob) {
+        free_object(&svp->u.ob, "remove_object_from_stack (suspended)");
+        svp->type = T_NUMBER;
+        svp->u.number = 0;
+      }
+    }
+  }
+}
+
+bool vm_suspended_frame_uses_prog(program_t* prog) {
+  if (!g_proto_walk_all) return false;
+  for (SuspendedStack* s = g_suspended; s; s = s->next) {
+    for (control_stack_t* f = s->cbase; f <= s->csp; f++) {
+      if ((f->ob && f->ob->prog == prog) || f->prog == prog) return true;
+    }
+  }
+  return false;
+}
+
+// Called from the interpreter when `outoftime` is set. True = carry on.
+bool hook_proto_eval_slowpath() {
+  if (g_hook_exempt) {
+    int64_t const el = us_since(g_hook_t0);
+    if (g_hook_caller_R < 0) g_hook_caller_R = el;  // the caller's own budget ran out here
+    if (el >= g_hook_budget_us) return false;      // watchdog: abort the handler
+    raw_timer_set(g_hook_budget_us - el);
+    return true;
+  }
+  if (g_eval_credit > 0) {  // time spent in exempt handlers is given back lazily
+    int64_t const c = g_eval_credit;
+    g_eval_credit = 0;
+    raw_timer_set(c);
+    return true;
+  }
+  return false;
+}
+
+svalue_t* hook_proto_run(funptr_t* f, int n, int flags, int budget_us, int* stale_slots) {
+  bool const use_alt = (flags & 1) && !g_in_alt;
+  bool const exempt = (flags & 4) && !g_hook_exempt;
+  int const saved_walk = g_proto_walk_all;
+  g_proto_walk_all = (flags & 2) != 0;
+  int64_t eager_ev = 0;
+  if (flags & 16) {
+    eager_ev = get_eval();
+    raw_timer_set(budget_us);
+  }
+  if (exempt) {
+    g_hook_exempt++;
+    g_hook_t0 = std::chrono::steady_clock::now();
+    g_hook_budget_us = budget_us;
+    g_hook_caller_R = -1;
+  }
+  f->hdr.ref++;
+  SuspendedStack ss{};
+  if (use_alt) {
+    svalue_t* args = sp - n + 1;
+    svalue_t* alt_start = &_alt_stack[10];
+    for (int i = 0; i < n; i++) alt_start[i] = args[i];  // move, no ref change
+    ss = {start_of_stack, sp - n, end_of_stack, control_stack, csp, control_stack_last, g_suspended};
+    g_suspended = &ss;
+    start_of_stack = alt_start;
+    end_of_stack = alt_start + kAltStackSize;
+    sp = alt_start + n - 1;
+    control_stack = &_alt_cstack[5];
+    control_stack_last = control_stack + kAltDepth - 1;
+    csp = control_stack - 1;
+    g_in_alt = true;
+  }
+  error_context_t econ;
+  save_context(&econ);
+  econ.save_sp -= n;
+  svalue_t* ret;
+  try {
+    ret = call_function_pointer(f, n);
+  } catch (const char*) {
+    restore_context(&econ);
+    ret = nullptr;
+  }
+  pop_context(&econ);
+  if (use_alt) {
+    start_of_stack = ss.start;
+    end_of_stack = ss.end;
+    sp = ss.sp;
+    control_stack = ss.cbase;
+    control_stack_last = ss.clast;
+    csp = ss.csp;
+    g_suspended = ss.next;
+    g_in_alt = false;
+  }
+  // evidence: destructed objects still sitting in the (now resumed) main stack
+  if (stale_slots) {
+    int c = 0;
+    for (svalue_t* svp = start_of_stack; svp <= sp; svp++) {
+      if (svp->type == T_OBJECT && (svp->u.ob->flags & O_DESTRUCTED)) c++;
+    }
+    *stale_slots = c;
+  }
+  free_funp(f);
+  g_proto_walk_all = saved_walk;
+  if (!ret) {
+    too_deep_error = 0;
+    if (exempt || (flags & 16)) {
+      max_eval_error = 0;
+      outoftime = 0;
+    }
+  }
+  if (exempt) {
+    int64_t const h = us_since(g_hook_t0);
+    g_hook_exempt--;
+    int64_t uncharged = h;
+    if (flags & 8) {
+      int64_t const left = budget_us - g_hook_allow_used;
+      uncharged = left > 0 ? (h < left ? h : left) : 0;
+      g_hook_allow_used += uncharged;
+    }
+    if (g_hook_caller_R >= 0) {
+      int64_t const remaining = g_hook_caller_R - (h - uncharged);
+      if (remaining > 0) {
+        raw_timer_set(remaining);
+      } else {
+        outoftime = 1;
+      }
+    } else {
+      g_eval_credit += uncharged;
+      // charged part needs no action: the caller's timer kept running
+    }
+  }
+  if (flags & 16) {
+    raw_timer_set(eager_ev);
+  }
+  return ret;
+}
