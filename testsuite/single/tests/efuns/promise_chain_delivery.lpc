// A long self-feeding then-chain is delivered completely, and each link
// exactly once.
//
// Work created DURING a drain turn is delivered in the same turn if the
// turn's evaluation budget allows -- `await` of an already-settled promise
// still parks, so an ordinary sequential loop
//
//     for (i = 0; i < n; i++) sum += await compute(i);
//
// is a causal chain in which each delivery enqueues exactly the next one, and
// making it pay an event-loop turn per link measured at ~4ms per await. What
// this file pins is that running the chain at full speed loses nothing: no
// link is stranded when a turn ends, and none is handed out twice.
//
// The BOUND on a turn -- one evaluation budget, shared by every delivery in
// it -- is pinned separately by promise_drain_eval_budget.lpc, which is the
// only place a turn can actually be made to run out under test: a trivial
// delivery costs a microsecond or two, so no realistic number of them comes
// near `maximum evaluation cost`.
//
// The chain runs entirely after do_tests() has returned, so it is declared
// with an EXIT LATCH and the checks are counted like any other.

// Many turns' worth of deliveries at a microsecond or two each, and still
// only milliseconds of work.
#define CHAIN_LEN 40000

nosave int n;

private void check_chain();

void feed() {
  promise p;

  if (++n > CHAIN_LEN) {
    // Not reachable by construction -- the link below is only chained while
    // the chain is short -- so this fires only if the drain delivered one
    // reaction twice, which a re-post that fails to consume its queue entry
    // would do.
    ASSERT2(0, "a chain link was delivered more than once (n=" + n + ")");
    return;
  }
  if (n == CHAIN_LEN) {
    // Checked from the LAST link rather than after a fixed delay, for the
    // reason testsuite/README.md gives: how long the chain takes to run is a
    // throughput property of the host and of whatever else the suite has
    // queued, not of anything this file pins. If the chain stalls, the exit
    // latch fails the run naming it.
    check_chain();
    return;
  }
  p = promise_create();
  promise_then(p, (: feed :));
  promise_resolve(p, 0);
}

private void check_chain() {
  // Nothing was stranded: reaching here at all means every link was
  // delivered, and feed()'s over-count guard means none was delivered twice.
  // (A count assertion here would be tautological -- this function is called
  // from the link that makes the count come out right.)
  RELEASE_LATCH("promise chain delivery");
}

void do_tests() {
  EXPECT_LATCH("promise chain delivery");

  // Started from a call_out: master::flag() holds the stack for the whole
  // run, so nothing queued during do_tests() is serviced until it returns,
  // and starting from a call_out keeps the ordering call_out-to-call_out,
  // which is defined (testsuite/README.md).
  call_out((: feed :), 1);
}
