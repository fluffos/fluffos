// A large backlog queued in one go is delivered completely, and each entry
// exactly once.
//
// Delivery (resumed await frames, settlement handlers) runs from the driver,
// and while it runs nothing else does: no socket reads, no command
// scheduling, no timers. So a drain turn is bounded -- by one evaluation
// budget shared across the deliveries in it -- and then RE-POSTS itself to
// the event loop, which is where pending network I/O is actually serviced.
// The queue survives that split intact, which is what this file pins:
// splitting a backlog across turns must not drop an entry or repeat one.
//
// The bound itself is pinned by promise_drain_eval_budget.lpc. It is not
// observable from a backlog of cheap deliveries: at a microsecond or two
// each, no realistic number of them approaches `maximum evaluation cost`, so
// a backlog like this one is expected to clear inside a single turn.

#define BACKLOG 20000

nosave int delivered;

private void check_results();

private mixed count_handler(mixed v) {
  delivered++;
  if (delivered > BACKLOG) {
    // Only BACKLOG promises were queued, so a delivery beyond that means the
    // drain handed one reaction out twice.
    ASSERT2(0, "a reaction was delivered more than once (delivered=" + delivered + ")");
    return v;
  }
  if (delivered == BACKLOG) {
    // Checked from the LAST delivery rather than after a fixed delay: a
    // deadline turns this into a throughput measurement (testsuite/README.md).
    check_results();
  }
  return v;
}

private void check_results() {
  // Reaching here at all means every delivery arrived, and count_handler's
  // over-count guard means none arrived twice. (A count assertion here would
  // be tautological -- this function is called from the delivery that makes
  // the count come out right.)
  RELEASE_LATCH("promise backlog delivery");
}

private void start_work() {
  int i;
  promise p;

  for (i = 0; i < BACKLOG; i++) {
    p = promise_create();
    promise_then(p, (: count_handler :));
    promise_resolve(p, i);
  }
}

void do_tests() {
  mapping info = async_info(1);

  // async_info(1) reports the scheduler; async_info() keeps its original
  // per-coroutine array form.
  ASSERT_EQ("mapping", typeof(info));
  ASSERT_EQ("array", typeof(async_info()));

  EXPECT_LATCH("promise backlog delivery");

  // Started from a call_out, so the ordering against the drain is call_out-
  // to-call_out, which is defined (testsuite/README.md).
  call_out((: start_work :), 1);
}
