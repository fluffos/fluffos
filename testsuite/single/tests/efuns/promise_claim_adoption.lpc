// The first resolution of a promise wins, adoption included. When the mudlib
// resolves a driver-settled promise (here call_out(delay)'s) with a promise
// that is still pending, the driver's own result arriving later must not
// override it. Driver sources checked `state` only, so the timer's 0 won and
// the adopted promise's value was dropped.
//
// Runs from call_outs under an exit latch: the timer and the deliveries only
// happen once the event loop runs.
#define LATCH "promise adoption claim"

promise timer, inner;

void start() {
  timer = call_out(1);            // the driver fulfils it with 0 after 1 s
  inner = promise_create();
  promise_resolve(timer, inner);  // resolved first: timer adopts inner
  call_out("finish", 3);          // after the timer has fired
}

void finish() {
  promise_resolve(inner, 42);
  call_out("check", 1);
}

void check() {
  ASSERT_EQ(1, promise_status(timer));  // fulfilled
  ASSERT_EQ(42, promise_result(timer));
  RELEASE_LATCH(LATCH);
}

void do_tests() {
  EXPECT_LATCH(LATCH);
  call_out("start", 1);
}
