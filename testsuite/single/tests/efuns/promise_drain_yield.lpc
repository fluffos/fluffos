// The microtask drain must never hog the event loop.
//
// Delivery (resumed await frames, settlement handlers) runs from the driver,
// and while it runs nothing else does: no socket reads, no command
// scheduling, no timers. So the drain makes a bounded number of deliveries
// per turn and then RE-POSTS itself to the event loop, which is where
// pending network I/O is actually serviced. Async work proceeds across as
// many turns as it needs, using time the driver would otherwise spend idle,
// without ever holding the loop.
//
// Two bounds, and the second is the one that matters:
//
//  - at most "async drain eval budget" of eval cost per turn, so a large backlog is
//    cut into predictable pieces instead of one long stall;
//  - work created DURING a turn counts toward that same batch, so a causal
//    chain (a sequential await loop) runs at full speed instead of paying a
//    loop turn per link. The batch is therefore the only bound, which makes
//    its size a responsiveness setting -- promise_drain_budget.lpc pins that
//    a self-feeding chain still yields once per batch.
//
// Yielding is observed through async_info(1)'s "drain_yields" counter rather
// than by timing. Wall clock cannot see it on every target: the wasm test
// runner drives the driver from a virtual clock, so a re-posted turn arrives
// with no real time elapsed and looks exactly like an immediate one.

nosave int delivered;
nosave int yields_before;
nosave int batch;

private void check_results();

private mixed count_handler(mixed v) {
  delivered++;
  if (delivered > batch * 3) {
    // Only batch*3 promises were queued, so a delivery beyond that means the
    // drain handed one reaction out twice.
    ASSERT2(0, "a reaction was delivered more than once (delivered=" + delivered + ")");
    return v;
  }
  if (delivered == batch * 3) {
    // Checked from the LAST delivery rather than after a fixed delay: a
    // deadline turns this into a throughput measurement, and the drain's
    // throughput is exactly what the batch size changes (at `async drain
    // batch : 1` the backlog takes three seconds to clear). From here the
    // count is right by construction and the yields have already happened.
    check_results();
  }
  return v;
}

private void check_results() {
  mapping info = async_info(1);

  // Splitting across turns loses nothing: reaching here at all means every
  // delivery arrived, and count_handler's over-count guard means none arrived
  // twice. (A count assertion here would be tautological -- this function is
  // called from the delivery that makes the count come out right.)
  // A backlog three times the batch cannot have been delivered in one turn.
  ASSERT2(info["drain_yields"] >= yields_before + 2,
    sprintf("a backlog of %d deliveries against a batch of %d produced only %d yields "
      "-- the drain is not re-posting, so it holds the event loop for the whole "
      "backlog",
      batch * 3, batch, info["drain_yields"] - yields_before));

  RELEASE_LATCH("promise drain yield");
}

private void start_work() {
  int i;
  promise p;

  yields_before = async_info(1)["drain_yields"];

  // Queue three batches' worth in one go, so the drain has to take at least
  // three turns to deliver them.
  for (i = 0; i < batch * 3; i++) {
    p = promise_create();
    promise_then(p, (: count_handler :));
    promise_resolve(p, i);
  }
}

void do_tests() {
  mapping info = async_info(1);

  // async_info(1) reports the scheduler; async_info() keeps its original
  // per-coroutine array form.
  ASSERT_EQ("mapping", typeof(info));
  ASSERT_EQ("array", typeof(async_info()));

  batch = info["drain_eval_budget"];
  ASSERT2(batch > 0, "async_info(1) should report the effective drain budget");

  EXPECT_LATCH("promise drain yield");

  // Started from a call_out: the suite holds the stack until it finishes, so
  // nothing scheduled here runs until then, and starting the work from a
  // call_out keeps the ordering call_out-to-call_out, which is defined
  // (testsuite/README.md). Only the START is scheduled -- the checks run from
  // the last delivery, and the latch holds the run open until they do. If
  // deliveries stop arriving the latch fails the run naming this test, which
  // is the failure this wants; a deadline would report a slow drain as a
  // broken one.
  call_out((: start_work :), 1);
}
