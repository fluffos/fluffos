// The microtask drain must never hog the event loop.
//
// Delivery (resumed await frames, settlement handlers) runs from the driver,
// and while it runs nothing else does: no socket reads, no command
// scheduling, no timers. So the drain spends at most `async drain eval
// budget` on a turn and then RE-POSTS itself to the event loop, which is
// where pending network I/O is actually serviced. Async work proceeds across
// as many turns as it needs, using time the driver would otherwise spend
// idle, without ever holding the loop.
//
// Work created DURING a turn counts toward that same turn, so a causal chain
// (a sequential await loop) runs at full speed instead of paying a loop turn
// per link. The time budget is therefore the only bound, which makes it a
// responsiveness setting -- promise_drain_budget.lpc pins that a self-feeding
// chain still yields once per turn.
//
// THE BUDGET IS TIME, NOT A COUNT, and the backlog here has to be built in
// the same unit. An earlier version queued `budget * 3` promises with trivial
// handlers and asserted three turns, reading the microsecond budget as if it
// were a delivery count. That is a throughput measurement: 3000 empty
// handlers fit inside 1000 us on a release build, so the whole backlog
// cleared in ONE turn and the file failed on the fastest CI targets (clang,
// macOS and Windows RelWithDebInfo) while passing everywhere slower. The
// handlers below instead burn a calibrated fraction of the budget each, so
// the backlog exceeds it by construction on any machine.
//
// Calibration alone was not enough either, and the second failure is worth
// recording because it looks exactly like a driver bug. burn_iters is sized
// from a sample taken BEFORE the backlog runs; a CI runner that shifts CPU
// frequency in between makes the real handlers cost a fraction of that, the
// whole backlog fits in one turn, and the file reports a perfectly healthy
// drain as "not re-posting" (observed on macOS RelWithDebInfo: 28 deliveries
// said to cost 250 us each, one yield, and the identical commit passed on
// re-run). So the handlers now MEASURE what they actually burn, and
// check_results() tests that premise before drawing any conclusion. A
// backlog that did not really exceed the budget proves nothing about
// re-posting, and saying so is not the same as passing silently -- that path
// still records a check.
//
// Yielding is observed through async_info(1)'s "drain_yields" counter rather
// than by timing the run. Wall clock cannot see it on every target: the wasm
// test runner drives the driver from a virtual clock, so a re-posted turn
// arrives with no real time elapsed and looks exactly like an immediate one.

// Each handler burns this fraction of the turn budget, so this many
// deliveries fill a turn.
#define HANDLERS_PER_TURN 4
// Turns' worth of backlog to queue. The assertion only demands 2 yields, so
// this carries a wide margin against a machine where the fixed per-delivery
// overhead shifts the arithmetic.
#define TARGET_TURNS 6
// Don't burn more than this per handler however large the budget is.
#define MAX_HANDLER_US 2000
// ... and give up rather than burn for minutes if the budget is enormous.
#define MAX_QUEUED 400
#define CALIBRATE_START 100000
#define CALIBRATE_TRIES 24
// Enough measured microseconds to scale from without rounding noise.
#define CALIBRATE_FLOOR 200

nosave int delivered;
nosave int queued;
nosave int yields_before;
nosave int budget_us;
nosave int handler_us;
nosave int burn_iters;
// What the handlers ACTUALLY cost, summed as they run -- the premise
// check_results() tests before drawing any conclusion about re-posting.
nosave int burned_us;
nosave int finished;

private void check_results();

private void burn(int n) {
  int i, x;

  for (i = 0; i < n; i++) {
    x += i;
  }
}

private void finish(mixed complaint) {
  if (finished++) {
    return;
  }
  if (complaint) {
    ASSERT2(0, complaint);
  }
  RELEASE_LATCH("promise drain yield");
}

private mixed count_handler(mixed v) {
  delivered++;
  if (delivered > queued) {
    // Only `queued` promises were made, so a delivery beyond that means the
    // drain handed one reaction out twice.
    finish("a reaction was delivered more than once (delivered=" + delivered + ")");
    return v;
  }
  // Measured, not assumed. calibrate() sizes burn_iters from a sample taken
  // BEFORE the backlog runs, and the two do not always agree: a CI runner
  // that shifts CPU frequency in between makes the real handlers cost a
  // fraction of the calibrated figure, the whole backlog then fits in one
  // turn, and the file reports a healthy drain as "not re-posting". That is
  // exactly what a macOS RelWithDebInfo runner did -- 28 deliveries said to
  // cost 250 us each produced a single yield, and the same commit passed on
  // re-run. Accumulating the real cost lets check_results() test its own
  // premise instead of trusting the calibration.
  burned_us += time_expression {
    burn(burn_iters);
  };
  if (delivered == queued) {
    // Checked from the LAST delivery rather than after a fixed delay: a
    // deadline turns this into a throughput measurement, and throughput is
    // exactly what the budget changes (at `async drain eval budget : 1` a
    // backlog trickles out one delivery per loop turn). From here the count
    // is right by construction and the yields have already happened.
    check_results();
  }
  return v;
}

private void check_results() {
  mapping info = async_info(1);

  // Splitting across turns loses nothing: reaching here at all means every
  // delivery arrived, and count_handler's over-count guard means none arrived
  // twice.
  //
  // Check the PREMISE before the conclusion. The claim is "a backlog that
  // exceeds the turn budget must be spread over turns", so if the backlog
  // did not actually exceed it there is nothing here to observe -- and
  // asserting anyway reports the machine, not the driver.
  //
  // Two budgets' worth is the bar, matching the two yields demanded below.
  // Still records a check either way: this path is the one a mis-calibrated
  // host takes, and a pass with no checks at all is indistinguishable from a
  // file that never ran.
  if (burned_us < budget_us * 2) {
    ASSERT2(delivered == queued,
      sprintf("the backlog measured only %d us against a %d us turn budget, so it "
        "never had to be split -- calibration expected about %d us. Nothing to "
        "conclude about re-posting, but every one of the %d deliveries did arrive",
        burned_us, budget_us, queued * handler_us, queued));
    finish(0);
    return;
  }

  ASSERT2(info["drain_yields"] >= yields_before + 2,
    sprintf("a backlog of %d deliveries measured at %d us total, against a turn "
      "budget of %d us, produced only %d yields -- the drain is not re-posting, "
      "so it holds the event loop for the whole backlog",
      queued, burned_us, budget_us, info["drain_yields"] - yields_before));

  finish(0);
}

// Iterations of burn() that cost about handler_us microseconds. Wall clock is
// the unit: the drain measures its turn on the monotonic clock, so the
// microseconds time_expression reports are the same microseconds it spends.
private void calibrate() {
  int iters = CALIBRATE_START;
  int cost = 0;
  int i;

  for (i = 0; i < CALIBRATE_TRIES; i++) {
    cost = time_expression {
      burn(iters);
    };
    if (cost >= CALIBRATE_FLOOR) {
      break;
    }
    iters *= 4;
  }
  if (cost < 1) {
    cost = 1;
  }
  burn_iters = iters * handler_us / cost;
  if (burn_iters < 100) {
    burn_iters = 100;
  }
}

private void start_work() {
  int i;
  promise p;

  handler_us = budget_us / HANDLERS_PER_TURN;
  if (handler_us < 1) {
    handler_us = 1;
  }
  if (handler_us > MAX_HANDLER_US) {
    handler_us = MAX_HANDLER_US;
  }
  queued = TARGET_TURNS * budget_us / handler_us + HANDLERS_PER_TURN;
  if (queued > MAX_QUEUED) {
    // A turn budget this large would need minutes of burning to overrun.
    // Nothing to observe and nothing to report -- deliberately not a failure.
    finish(0);
    return;
  }
  calibrate();

  yields_before = async_info(1)["drain_yields"];
  for (i = 0; i < queued; i++) {
    p = promise_create();
    promise_then(p, (: count_handler :));
    promise_resolve(p, i);
  }
}

void do_tests() {
  mapping info = async_info(1);

  // async_info(1) reports the scheduler; async_info() keeps its original
  // per-coroutine array form.
  ASSERT_EQ("mapping", typeof(info));
  ASSERT_EQ("array", typeof(async_info()));

  budget_us = info["drain_eval_budget"];
  ASSERT2(budget_us > 0, "async_info(1) should report the effective drain budget");

  EXPECT_LATCH("promise drain yield");

  // Started from a call_out: the suite holds the stack until it finishes, so
  // nothing scheduled here runs until then, and starting the work from a
  // call_out keeps the ordering call_out-to-call_out, which is defined
  // (testsuite/README.md). Only the START is scheduled -- the checks run from
  // the last delivery, and the latch holds the run open until they do. If
  // deliveries stop arriving the latch fails the run naming this test, which
  // is the failure this wants; a deadline would report a slow drain as a
  // broken one.
  call_out((: start_work :), 1);
}
