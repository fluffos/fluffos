// An inherited async function yields a promise on BOTH call routes: the
// plain call (typed via FUNCTION_FLAGS in the grammar rules) and the
// `base::fn()` qualified call (typed in find_matching_function, which has
// the flags in hand but used to ignore FUNC_ASYNC).
//
// The rejections are compiler/fail/bad_async_inherited_type.lpc and
// bad_async_qualified_type.lpc.

inherit "/clone/async_inherit_base";

nosave int inhResumed;

async void awaits_both() {
  int a = await base_async(1);
  int b = await async_inherit_base::base_async(10);
  string *s = await async_inherit_base::base_async_arr();

  ASSERT_EQ(2, a);
  ASSERT_EQ(11, b);
  ASSERT_EQ(({ "a" }), s);
  inhResumed++;
}

void do_tests() {
  promise<int> p, q;
  promise<string *> r;

  p = base_async(1);
  q = async_inherit_base::base_async(10);
  r = async_inherit_base::base_async_arr();

  ASSERT_EQ("promise", typeof(p));
  ASSERT_EQ("promise", typeof(q));
  ASSERT_EQ("PROMISE<int>( fulfilled: 2 )", sprintf("%O", p));
  ASSERT_EQ("PROMISE<int>( fulfilled: 11 )", sprintf("%O", q));
  ASSERT_EQ("PROMISE<array>", sprintf("%O", r)[0..13]);

  call_out(function() { awaits_both(); }, 1);
  call_out(function() {
    ASSERT2(inhResumed == 1, sprintf("awaits_both: %O", inhResumed));
    if (inhResumed != 1) shutdown(-1);
  }, 3);
}
