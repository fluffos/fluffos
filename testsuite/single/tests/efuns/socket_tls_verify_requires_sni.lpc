#ifdef __PACKAGE_SOCKETS__
#include <socket.h>
#include <socket_err.h>

// socket_connect() with SO_TLS_VERIFY_PEER set but no SO_TLS_SNI_HOSTNAME
// used to silently fall back to chain-only certificate validation -- any
// certificate a trusted CA issued for ANY name would pass, the exact MITM
// exposure SO_TLS_VERIFY_PEER exists to close. It must instead refuse the
// connect. A plain (non-TLS) local listener is enough: the check fires
// synchronously in socket_connect() right after the TCP connect() call,
// before any TLS handshake is attempted.

nosave int server_fd = -1;
nosave int client_fd = -1;

void rcb(int fd, mixed msg) {}
void wcb(int fd) {}
void accept_cb(int fd) {}

void do_tests() {
  string local;
  string *parts;
  int port;
  int ret;

  server_fd = socket_create(STREAM, "accept_cb");
  ASSERT2(server_fd >= 0, "failed to create server socket");
  ASSERT_EQ(EESUCCESS, socket_bind(server_fd, 0));
  ASSERT_EQ(EESUCCESS, socket_listen(server_fd, "accept_cb"));

  local = socket_address(server_fd, 1);
  parts = explode(local, " ");
  ASSERT_EQ(2, sizeof(parts));
  port = to_int(parts[1]);

  client_fd = socket_create(STREAM_TLS, "rcb", "wcb");
  ASSERT2(client_fd >= 0, "failed to create client socket");

  socket_set_option(client_fd, SO_TLS_VERIFY_PEER, 1);
  // Deliberately no SO_TLS_SNI_HOSTNAME set.

  ret = socket_connect(client_fd, sprintf("127.0.0.1 %d", port), "rcb", "wcb");
  ASSERT2(ret < 0, "socket_connect must refuse SO_TLS_VERIFY_PEER with no SNI hostname set");

  socket_close(client_fd);
  socket_close(server_fd);
}

#else
void do_tests() {
  write("PACKAGE_SOCKETS not available, skipping test.\n");
}
#endif
