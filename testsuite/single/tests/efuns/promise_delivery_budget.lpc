// A promise delivery is never cut short by what the drain turn already spent.
//
// The drain bounds how many deliveries a turn STARTS -- that is what keeps
// the event loop responsive under a backlog -- but it never interrupts one it
// has started. Each delivery is armed with a whole `maximum evaluation cost`
// of its own, exactly like a call_out() callback, so a resumed async function
// or a settlement handler runs to its own natural end no matter how much time
// the deliveries ahead of it in the same turn used. When the turn's budget is
// gone the REMAINING deliveries are pushed past the next I/O poll; nothing in
// flight is aborted and nothing is dropped.
//
// Sharing one budget across a turn was tried and is wrong for exactly this
// reason: an innocent handler took "Too long evaluation" because the handlers
// ahead of it had spent the turn's time. This file pins that it cannot
// happen, on both paths that arm a budget:
//
//   * a promise_then() handler, and
//   * an async function resumed from a parked `await`.
//
// The observable is the budget REMAINING (`set_eval_limit(-1)`), sampled in
// the first delivery and again in the second, with a small calibrated burn in
// between. Sharing one budget means the second sample is LOWER by at least
// the burn, because one countdown only goes one way. Arming afresh means the
// two readings are INDEPENDENT samples of a single delivery's own start-up
// overhead, so their difference is noise centred on zero.
//
// That noise is the whole difficulty, and it is why this is measured over
// several rounds instead of once. The burn has to stay well under the turn
// budget -- both samples only compare if they land in the SAME turn, and an
// earlier version that burned a third of the budget was inconclusive on every
// attempt on a sanitizer build, where one delivery's overhead already fills
// most of a turn. But that same overhead is what makes a single round
// unreliable: measured on a clang ASan Debug build, the per-round difference
// ranged from -103 us to +77 us against a 100 us burn, so a threshold of half
// the burn sat INSIDE the noise band and the file failed roughly one run in
// six. Raising the burn does not help -- at 400 us the pair stopped fitting
// in one turn and the probe became inconclusive instead.
//
// So the observable is the MINIMUM difference over several rounds. A shared
// budget drops the reading by at least the burn on EVERY round, so its
// minimum is still at least the burn. Independent samples put the minimum
// firmly negative: at the measured distribution one round exceeds the
// threshold about 8% of the time, so several rounds all doing so is not
// something that happens.
//
// When a turn ends between a round's two samples, that round runs again
// rather than asserting on a coincidence; exhausting the retries reports on
// the rounds already collected, or -- if there are too few -- attributes the
// failure to fit. That attribution is a measurement, not a guess: the first
// delivery times itself, and the question asked is whether the turn budget
// holds TWO deliveries of that size. If it does and the turn ended anyway,
// the drain cut a turn short with budget to spare, which is a real
// regression. If it does not, there was never room for a second delivery and
// there is nothing here to measure -- a slow build, or a deliberately tiny
// budget. The old rule -- "the budget is at least ten times the burn, so it
// must have been roomy" -- was satisfied by exact equality at the default
// 1000 us budget while one delivery on a Debug sanitizer build costs 650-760
// us of it, so it reported a slow machine as a driver defect about half the
// time.
//
// Know what that skip costs, because it is a real blind spot and not just a
// quieter test. Wherever one delivery is at least half the budget, this file
// can no longer tell a slow host from a drain that cuts turns short -- it
// takes the skip branch either way. Verified: against a driver deliberately
// patched to end every turn after one delivery, this file FAILS as intended
// at the default budget, but PASSES under `async drain eval budget : 300`,
// while a healthy driver at that same 300 us completes the probe normally.
// So the coverage rests on the FAST configs in the CI matrix reaching the
// defect branch, and a drain regression that only manifests on a slow or
// sanitizer build would slip past. The old rule did not have that hole -- it
// simply failed constantly on those builds instead, which is why it went.
// The other consequence of measuring with the thing being measured: if a
// change makes a DELIVERY itself several times slower, every host moves into
// the skip branch and this file goes quiet rather than complaining. That
// shape belongs to `-fspeed:` benchmarking, not here, but do not read this
// file's silence as proof the scheduler is healthy.

#define PROBE_ITERS 200000
// Well above eval-timer granularity, well below the default 1000 us turn
// budget.
#define BURN_US 100
#define MAX_ATTEMPTS 20
// Rounds to collect, and the fewest that still make the minimum meaningful.
#define PROBE_ROUNDS 6
#define MIN_ROUNDS 3

nosave int burn_iters;
nosave int burn_us;
nosave int budget_us;
nosave int sample_before;
nosave int first_cost_us;
nosave int yields_at_first;
nosave int attempts;
nosave int rounds;
nosave int min_diff;
nosave int finished;

private async void probe();
private void start_probe();
private void conclude();

private void burn(int n) {
  int i, x;

  for (i = 0; i < n; i++) {
    x += i;
  }
}

private void finish(mixed complaint) {
  if (finished++) {
    return;
  }
  if (complaint) {
    ASSERT2(0, complaint);
  }
  RELEASE_LATCH("promise delivery budget");
}

// Resumed from the parked await below, still inside the drain turn that
// delivered first_handler() -- unless the turn ended in between, which the
// yield counter reports and which is not a result either way.
private async void probe() {
  promise p;
  int sample_after;

  p = promise_create();
  promise_resolve(p, 0);
  await p;

  if (async_info(1)["drain_yields"] != yields_at_first) {
    if (++attempts < MAX_ATTEMPTS) {
      start_probe();
      return;
    }
    if (rounds >= MIN_ROUNDS) {
      // Enough rounds already collected to conclude from.
      conclude();
      return;
    }
    // The pair never fit. Two very different reasons, and only one of them is
    // a defect, so attribute it by MEASUREMENT rather than by assuming the
    // turn budget is roomy. first_cost_us is what one delivery actually
    // spent, and two of them have to fit in a turn for there to be anything
    // to compare -- so that is the question asked here.
    if (first_cost_us * 2 < budget_us) {
      // It does, and the turn ended anyway -- the drain is cutting turns
      // short while it still has budget, which is a real scheduling
      // regression and not something this host can explain.
      finish(sprintf("after %d attempts the two probe deliveries never landed in "
        "the same drain turn, even though the first delivery spent only %d us of "
        "the %d us turn budget -- the drain is ending turns it has budget left "
        "for, so this file never got to test anything",
        attempts, first_cost_us, budget_us));
    } else {
      // It does not, so a second delivery can never follow the first and
      // there is nothing to observe. Deliberately not a failure -- the drain
      // is doing exactly what it should. Two supported ways to get here: a
      // tiny `async drain eval budget` (the hostile-config matrix runs
      // `: 1`), and a build slow enough that one delivery costs more than
      // half the default 1000 us, which a Debug sanitizer build on a modest
      // host does -- measured at 650-760 us there, against the ~100 us burn.
      // Most of that is the handler's own async_info(1) mapping and the
      // eval-limit reads, not the burn, so shrinking the burn would not buy
      // the room back.
      //
      // Record a check anyway. A pass with no checks at all is
      // indistinguishable from a file that never ran, and this is the path
      // every slow build takes. What reaching it proves is worth stating:
      // each attempt was a delivery the drain DEFERRED past a turn boundary
      // and then delivered. Had deferral dropped the work, this frame would
      // still be parked and the run would fail on the unreleased latch.
      ASSERT2(attempts >= 1,
        sprintf("the pair never fit in one turn (one delivery costs %d us of a "
          "%d us budget), so every attempt crossed a turn boundary -- and every "
          "one of them still resumed",
          first_cost_us, budget_us));
      finish(0);
    }
    return;
  }

  sample_after = set_eval_limit(-1);
  if (!rounds || sample_before - sample_after < min_diff) {
    min_diff = sample_before - sample_after;
  }
  if (++rounds < PROBE_ROUNDS) {
    attempts = 0;
    start_probe();
    return;
  }
  conclude();
}

private void conclude() {
  // Asserted rather than returned quietly, so a passing run RECORDS a check.
  // Every skip path in this file (unmetered platform, budget too small to fit
  // the pair, retries exhausted) also ends in finish(0), and a pass that
  // records nothing is indistinguishable from a probe that never ran.
  ASSERT2(rounds >= MIN_ROUNDS,
    sprintf("only %d of %d probe rounds completed, which is too few for the "
      "minimum to mean anything",
      rounds, PROBE_ROUNDS));
  // Shared budget: every round is down by at least the burn, so the minimum
  // is too. Armed afresh: the rounds are independent samples of one
  // delivery's own overhead, so the minimum sits below zero.
  ASSERT2(min_diff <= burn_us / 2,
    sprintf("over %d rounds, a delivery made after one that burned about %d us "
      "of its budget never once had its own budget back: the smallest drop was "
      "%d us. It is inheriting the turn's leftovers instead of being armed "
      "afresh, so a handler can be aborted for time spent by the handlers ahead "
      "of it",
      rounds, burn_us, min_diff));
  finish(0);
}

private mixed first_handler(mixed v) {
  // What the turn has spent by the time this delivery ends -- start_probe()
  // resolves exactly one promise, so this handler IS the turn up to here, and
  // the drain compares this against the turn budget to decide whether to
  // start the resumed probe() in the same turn. Measured so that "the pair
  // never fit" can be attributed: see the retry-exhausted branch above.
  first_cost_us = time_expression {
    yields_at_first = async_info(1)["drain_yields"];
    // Sampled BEFORE the burn, so a shared budget shows the burn as a drop.
    sample_before = set_eval_limit(-1);
    burn(burn_iters);
    // Runs synchronously up to its `await` and returns its promise; the
    // resume is what the drain may or may not start in this same turn.
    probe();
  };
  return v;
}

private void start_probe() {
  promise p = promise_create();

  promise_then(p, (: first_handler :));
  promise_resolve(p, 0);
}

// Is eval cost metered on this platform at all? get_eval() only reads a real
// timer on Linux; elsewhere it returns the configured maximum unchanged, and
// there is nothing here to measure.
private int metered() {
  int a, b;

  a = set_eval_limit(-1);
  burn(PROBE_ITERS);
  b = set_eval_limit(-1);
  return b < a;
}

private void calibrate() {
  int cost;

  budget_us = async_info(1)["drain_eval_budget"];
  burn_us = BURN_US;
  // Wall clock is the unit: FluffOS meters eval cost with a POSIX
  // CLOCK_MONOTONIC timer, so the microseconds time_expression reports ARE
  // the eval cost the same work spends.
  cost = time_expression {
    burn(PROBE_ITERS);
  };
  if (cost < 1) {
    cost = 1;
  }
  burn_iters = PROBE_ITERS * burn_us / cost;
  if (burn_iters < 100) {
    burn_iters = 100;
  }
  if (burn_iters > 500000000) {
    burn_iters = 500000000;
  }
}

private void run() {
  if (!metered()) {
    finish(0);
    return;
  }
  calibrate();
  start_probe();
}

void do_tests() {
  EXPECT_LATCH("promise delivery budget");

  // From a call_out, so the ordering against the drain is call_out-to-
  // call_out (testsuite/README.md): master::flag() holds the stack for the
  // whole run, so nothing queued during do_tests() is serviced until it
  // returns.
  call_out((: run :), 1);
}
