void do_tests() {
  // Use midday so the round trip is independent of the configured time zone.
  string date = "01 May 2020 12:00:00";
  string format = "%d %B %Y %H:%M:%S";
  ASSERT_EQ(date, strftime(format, strptime(format, date)));
  ASSERT(strptime("%m/%d/%Y %H:%M:%S", "10/11/2020 16:12:51") > 0);
  ASSERT(catch(strptime("%1234", "whatever")));
}
