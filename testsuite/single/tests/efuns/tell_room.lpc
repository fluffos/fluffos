void do_tests() {
  object tp;
  object room = clone_object("/clone/catch_tell_probe");
  object l1 = clone_object("/clone/catch_tell_probe");
  object l2 = clone_object("/clone/catch_tell_probe");

  SAVETP;
  l1->enter(room);
  l2->enter(room);
  // Only LIVING objects hear tell_room.
  l1->make_living();
  l2->make_living();
  tell_room(room, "hello room");
  ASSERT_EQ("hello room", l1->last_message());
  ASSERT_EQ("hello room", l2->last_message());
  // Exclusion list.
  tell_room(room, "second", ({ l2 }));
  ASSERT_EQ("second", l1->last_message());
  ASSERT_EQ("hello room", l2->last_message());
  destruct(l1); destruct(l2); destruct(room);
  RESTORETP;

  // A room given by name is loaded (running its create()) after the
  // exclusion argument is read: here the load destructs the excluded
  // object, which zeroes its argument slot. Master then dereferenced a
  // null exclusion list.
  {
    object victim = load_object("/clone/tell_room_victim");
    object loaded = find_object("/clone/tell_room_loads_victim");

    if (loaded) {
      destruct(loaded);
    }
    ASSERT(!catch(tell_room("/clone/tell_room_loads_victim", "x", victim)));
    ASSERT(!victim);
    destruct(find_object("/clone/tell_room_loads_victim"));
  }
}
