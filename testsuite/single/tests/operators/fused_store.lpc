// Fused stores (issue #1358): a compound op, ++/--, or an indexed store
// whose destination is a local, a parameter, a global, or one index into one
// of those names the slot in its own operands (local_op / global_op /
// index_local_op / index_global_op) instead of pushing an lvalue. These
// check that every fused form computes what the unfused lvalue sequence did,
// that the containers without a fast path (strings, buffers, bad values)
// still fall back with the same results and errors, and -- via dump_prog --
// that the fused opcodes are actually emitted.

class Pair {
  int left;
}

int g;
int *ga;
mapping gm;
string gs;

void test_local_compound() {
  int x;
  float f;
  mixed mx;

  x = 10;
  x += 5;
  ASSERT_EQ(15, x);
  ASSERT_EQ(20, x += 5);
  x -= 3;
  ASSERT_EQ(17, x);
  ASSERT_EQ(34, x *= 2);
  x /= 4;
  ASSERT_EQ(8, x);
  x %= 5;
  ASSERT_EQ(3, x);
  x |= 4;
  ASSERT_EQ(7, x);
  x &= 6;
  ASSERT_EQ(6, x);
  x ^= 3;
  ASSERT_EQ(5, x);
  x <<= 2;
  ASSERT_EQ(20, x);
  x >>= 1;
  ASSERT_EQ(10, x);

  f = 1.5;
  f += 1;
  ASSERT_EQ(2.5, f);
  f *= 2;
  ASSERT_EQ(5.0, f);

  // An untyped slot still promotes to float through op= (#1303).
  mx = 1;
  mx += 0.5;
  ASSERT_EQ(1.5, mx);

  // Division by zero is still an error, and leaves x unchanged.
  x = 9;
  ASSERT(catch(x /= 0));
  ASSERT_EQ(9, x);
}

void test_local_incdec() {
  int x;
  float f;

  x = 5;
  x++;
  ASSERT_EQ(6, x);
  x--;
  ASSERT_EQ(5, x);
  ASSERT_EQ(5, x++);
  ASSERT_EQ(6, x);
  ASSERT_EQ(7, ++x);
  ASSERT_EQ(7, x--);
  ASSERT_EQ(5, --x);
  ASSERT_EQ(5, x);

  f = 1.5;
  ASSERT_EQ(1.5, f++);
  ASSERT_EQ(3.5, ++f);
  ASSERT_EQ(3.5, f--);
  ASSERT_EQ(1.5, --f);

  {
    mixed s = "x";
    ASSERT_EQ("*++ of non-numeric argument\n", catch(s++));
    ASSERT_EQ("*-- of non-numeric argument\n", catch(--s));
    ASSERT_EQ("x", s);
  }
}

void test_reference_types() {
  string s;
  int *a;
  int *alias;
  mapping m;
  mapping malias;

  s = "ab";
  s += "cd";
  s += 1;
  ASSERT_EQ("abcd1", s);

  // array += makes a new array; the alias keeps the old one.
  a = ({ 1 });
  alias = a;
  a += ({ 2 });
  ASSERT_EQ(({ 1, 2 }), a);
  ASSERT_EQ(({ 1 }), alias);
  a -= ({ 1 });
  ASSERT_EQ(({ 2 }), a);

  // mapping += absorbs in place; the alias sees it.
  m = ([ "a": 1 ]);
  malias = m;
  m += ([ "b": 2 ]);
  ASSERT_EQ(2, sizeof(malias));
  ASSERT_EQ(2, malias["b"]);
}

void test_globals() {
  g = 1;
  g += 2;
  ASSERT_EQ(3, g);
  ASSERT_EQ(3, g++);
  ASSERT_EQ(5, ++g);
  g *= 3;
  ASSERT_EQ(15, g);
  ASSERT_EQ(14, --g);
  g--;
  ASSERT_EQ(13, g);

  gs = "a";
  gs += "b";
  ASSERT_EQ("ab", gs);
}

void test_parameters() {
  function f;

  f = (: $1 += 2 :);
  ASSERT_EQ(5, evaluate(f, 3));
  f = (: $1++ :);
  ASSERT_EQ(3, evaluate(f, 3));
  f = (: ++$1 :);
  ASSERT_EQ(4, evaluate(f, 3));
}

int bump(int n) {
  n += 10;
  n++;
  return n;
}

void test_index_array() {
  int *a;

  a = ({ 1, 2, 3 });
  a[0] = 10;
  ASSERT_EQ(({ 10, 2, 3 }), a);
  ASSERT_EQ(20, a[1] = 20);
  a[2] += 5;
  ASSERT_EQ(8, a[2]);
  ASSERT_EQ(9, a[2] += 1);
  a[0]++;
  ASSERT_EQ(11, a[0]);
  ASSERT_EQ(11, a[0]--);
  ASSERT_EQ(11, ++a[0]);
  ASSERT_EQ(10, --a[0]);
  a[1] *= 2;
  a[1] -= 1;
  ASSERT_EQ(39, a[1]);
  ASSERT_EQ(({ 10, 39, 9 }), a);

  // Element stores write through to every holder of the array.
  {
    int *alias = a;
    a[0] = 99;
    ASSERT_EQ(99, alias[0]);
  }

  ASSERT_EQ("*Array index out of bounds\n", catch(a[3] = 1));
  {
    int neg = -1;
    ASSERT_EQ("*Array index out of bounds\n", catch(a[neg] = 1));
  }
  ASSERT_EQ("*Array index out of bounds\n", catch(a[3]++));
  ASSERT_EQ("*Array index out of bounds\n", catch(a[5] += 1));
  // An index past 32 bits used to be truncated to an int and could land
  // back inside the array; it is out of bounds.
  ASSERT_EQ("*Array index out of bounds\n", catch(a[0x100000000] = 7));
  ASSERT_EQ(({ 99, 39, 9 }), a);

  // A non-integer index takes the general path and its error.
  {
    mixed k = "x";
    ASSERT_EQ("*Illegal type of index\n", catch(a[k] = 1));
  }

  // A compound op that errors leaves the element alone.
  {
    mixed *m = ({ 1 });
    ASSERT(catch(m[0] -= "x"));
    ASSERT_EQ(({ 1 }), m);
  }
}

void test_index_mapping() {
  mapping m;
  mapping alias;

  m = ([]);
  m["a"] = 1;
  ASSERT_EQ(1, m["a"]);
  ASSERT_EQ(2, m["b"] = 2);
  m["a"] += 4;
  ASSERT_EQ(5, m["a"]);
  // A missing key is created by op= and ++ like the unfused path did.
  m["n"]++;
  ASSERT_EQ(1, m["n"]);
  m["c"] += 3;
  ASSERT_EQ(3, m["c"]);
  ASSERT_EQ(0, m["z"]++);
  ASSERT_EQ(1, m["z"]);
  ASSERT_EQ(6, ++m["a"]);

  alias = m;
  m["shared"] = "yes";
  ASSERT_EQ("yes", alias["shared"]);

  m[({ 1 })] = 1;  // any key type
  ASSERT_EQ(6, sizeof(m) - 1);
}

void test_index_globals() {
  ga = ({ 1, 2 });
  ga[0] = 5;
  ga[1] += 1;
  ga[1]++;
  ASSERT_EQ(({ 5, 4 }), ga);
  ASSERT_EQ(4, ga[1]--);

  gm = ([]);
  gm["k"] = 1;
  gm["k"] += 1;
  gm["j"]++;
  ASSERT_EQ(2, sizeof(gm));
  ASSERT_EQ(2, gm["k"]);
  ASSERT_EQ(1, gm["j"]);

  gs = "abc";
  gs[0] = 'X';
  gs[1]++;
  ASSERT_EQ("Xcc", gs);
}

void test_index_fallback() {
  string s;
  buffer b;
  mixed z;

  // String chars: rebuilt in place through the general char lvalue.
  s = "abc";
  s[0] = 'X';
  ASSERT_EQ("Xbc", s);
  s[1]++;
  ASSERT_EQ("Xcc", s);
  ASSERT_EQ('c', s[2]--);
  ASSERT_EQ("Xcb", s);
  s[2] += 2;
  ASSERT_EQ("Xcd", s);
  ASSERT_EQ("*Index out of bounds in string index lvalue.\n", catch(s[3] = 'y'));

  // Buffer bytes.
  b = allocate_buffer(2);
  b[0] = 255;
  ASSERT_EQ(255, b[0]);
  ASSERT_EQ("*Buffer byte value out of range: must be 0..255.\n", catch(b[0]++));
  b[1] += 7;
  ASSERT_EQ(7, b[1]);
  ASSERT_EQ("*Buffer index out of bounds.\n", catch(b[2] = 1));

  // Indexing zero / a non-container.
  z = 0;
  ASSERT_EQ("*Value being indexed is zero.\n", catch(z[0] = 1));
  z = 1.5;
  ASSERT_EQ("*Cannot index value of type 'float'.\n", catch(z[0] = 1));
}

void test_unfused_shapes() {
  // Shapes the fused ops do not cover still work through the lvalue path.
  mixed *nested = ({ ({ 1, 2 }), ({ 3 }) });
  mapping mm = ([ "a": ([ "b": 1 ]) ]);
  int *a = ({ 1, 2, 3, 4 });
  class Pair p = new(class Pair, left: 1);

  nested[0][1] += 5;
  nested[1][0]++;
  ASSERT_EQ(({ ({ 1, 7 }), ({ 4 }) }), nested);
  mm["a"]["b"] += 1;
  ASSERT_EQ(2, mm["a"]["b"]);
  a[<1] = 9;
  a[<2]++;
  ASSERT_EQ(({ 1, 2, 4, 9 }), a);
  a[0..1] = ({ 7 });
  ASSERT_EQ(({ 7, 4, 9 }), a);
  p->left += 2;
  ASSERT_EQ(3, p->left);

  // The general index path also rejects an index past 32 bits instead of
  // truncating it into range.
  {
    int big = 0x100000000;
    string s = "abc";
    ASSERT_EQ("*Array index out of bounds\n", catch(nested[0][big] = 7));
    ASSERT_EQ(({ 1, 7 }), nested[0]);
    ASSERT_EQ("*Index out of bounds in string index lvalue.\n", catch(s[big] = 'x'));
    ASSERT_EQ("abc", s);
  }
}

// Globals of an inherited program sit at a non-zero variable_index_offset;
// the fused global ops must add it, from the inheriting program's code and
// from the inherited program's own functions.
void test_inherited_globals() {
  object ob;
  mixed err;

  write_file("/data/fused_pad.c", "int p1, p2, p3;\n");
  write_file("/data/fused_base.c",
    "int bg; int *ba; mapping bm;\n"
    "void base_ops() { bg += 2; bg++; ba[1] += 5; bm[\"k\"]++; }\n");
  write_file("/data/fused_child.c",
    "inherit \"/data/fused_pad\";\n"
    "inherit \"/data/fused_base\";\n"
    "mixed run() {\n"
    "  p1 = 100; p2 = 200; p3 = 300;\n"
    "  bg = 1; ba = ({ 0, 1 }); bm = ([ ]);\n"
    "  base_ops();\n"
    "  bg *= 10; ba[0]--; bm[\"k\"] += 4; ++bm[\"j\"];\n"
    "  return ({ p1, p2, p3, bg, ba, bm });\n"
    "}\n");
  err = catch {
    ob = load_object("/data/fused_child");
    mixed r = ob->run();
    ASSERT_EQ(({ 100, 200, 300, 40, ({ -1, 6 }) }), r[0..4]);
    ASSERT_EQ(5, r[5]["k"]);
    ASSERT_EQ(1, r[5]["j"]);
  };
  if (ob) {
    destruct(ob);
  }
  foreach (string f in ({ "child", "base", "pad" })) {
    object o = find_object("/data/fused_" + f);
    if (o) {
      destruct(o);
    }
    rm("/data/fused_" + f + ".c");
  }
  ASSERT_EQ(0, err);
}

// $N parameters in a functional are locals at an offset; the fused index
// ops on them go through the same slot operand.
void test_parameter_index() {
  int *a = ({ 1, 2 });
  mapping m = ([]);
  function f;

  f = (: $1[0] += $2 :);
  ASSERT_EQ(11, evaluate(f, a, 10));
  ASSERT_EQ(({ 11, 2 }), a);
  f = (: $1[$2]++ :);
  ASSERT_EQ(0, evaluate(f, m, "x"));
  ASSERT_EQ(1, m["x"]);
  f = (: $1[1] = $2 * 2 :);
  evaluate(f, a, 4);
  ASSERT_EQ(({ 11, 8 }), a);
}

// The mapping fast path pops a refcounted key before the op runs; an op
// that then errors must not leak or double-free it (Debug runs
// check_memory() after this file).
void test_mapping_errors() {
  mapping m = ([]);
  mixed *keys = ({ "str" + "ing", ({ 1 }), ([]) });

  foreach (mixed k in keys) {
    ASSERT(catch(m[k] += "s"));
    ASSERT(catch(m[k] /= 0));
    m[k] = "s";
    ASSERT(catch(++m[k]));
  }
  // a key created by a failed op= stays, as on the unfused path
  ASSERT_EQ(3, sizeof(m));
}

// ++/-- of an undefined slot leaves a real number (AGENTS.md 13.11).
void test_undefined_incdec() {
  mixed x;
  mapping m = ([]);

  ASSERT(undefinedp(x));
  x++;
  x--;
  ASSERT_EQ(0, x);
  ASSERT(!undefinedp(x));
  m["n"]++;
  ASSERT_EQ(1, m["n"]);
  ASSERT(!undefinedp(m["n"]));
}

// Containers that hold themselves; break the loops before returning.
void test_self_reference() {
  mixed *a = ({ 0, 1 });
  mapping m = ([]);

  a[0] = a;
  a[0] -= ({ 1 });  // a[0] = ({ a })
  ASSERT_EQ(1, sizeof(a[0]));
  ASSERT(a[0][0] == a);
  a[0] = 0;
  m["x"] = m;
  m["x"] += ([ "y": 1, "z": 2 ]);
  ASSERT_EQ(1, m["y"]);
  m["x"] = 0;
  ASSERT_EQ(3, sizeof(m));
  ASSERT_EQ(2, m["z"]);
}

// A store split over several lines reports the line of its target, as the
// unfused sequence did.
void test_error_line() {
  object ob;
  string err;

  write_file("/data/fused_line.c",
    "int f() {\n"
    "  mixed x = 1;\n"
    "  x /=\n"
    "    0;\n"
    "  return x;\n"
    "}\n");
  catch {
    ob = load_object("/data/fused_line");
    "/single/master"->clear_last_error();
    catch(ob->f());
    err = "/single/master"->get_last_error();
  };
  if (ob) {
    destruct(ob);
  }
  rm("/data/fused_line.c");
  ASSERT(stringp(err));
  ASSERT2(strsrch(err, "Line: 3\n") != -1, err);
}

void test_dump_prog() {
#ifdef __PACKAGE_DEVELOP__
  object ob;
  string txt, src;
  string lop, gop, ilop, igop, llv, glv, ilv;

  // Needles assembled at runtime so they do not sit in this file's string
  // table (dump_prog prints that table too).
  lop = "local" + "_op";
  gop = "global" + "_op";
  ilop = "index_local" + "_op";
  igop = "index_global" + "_op";
  llv = "local" + "_lvalue";
  glv = "global" + "_lvalue";
  ilv = "index" + "_lvalue";

  src = "#pragma no_optimize\n"
    "int g; int *ga; mapping gm;\n"
    "int f(int n) { int x; int *a = ({ 1 }); mapping m = ([]);\n"
    "  x += n; x++; ++x; x--; g -= n; g++; a[0] = n; a[0] += n; a[0]++;\n"
    "  m[\"k\"] = n; m[\"k\"] *= 2; ga[0] = 1; ga[0] |= 2; gm[\"k\"]--;\n"
    "  return x; }\n";
  rm("/data/gen_fused_store.c");
  write_file("/data/gen_fused_store.c", src);
  catch {
    ob = load_object("/data/gen_fused_store");
    dump_prog(ob, 1, "/data/gen_fused_store_dump.txt");
    txt = read_file("/data/gen_fused_store_dump.txt");
  };
  if (ob) {
    destruct(ob);
  }
  rm("/data/gen_fused_store.c");
  rm("/data/gen_fused_store_dump.txt");
  ASSERT(stringp(txt));
  // dump_prog pads opcode names, so a leading space keeps "local_op" from
  // matching inside "index_local_op".
  ASSERT(strsrch(txt, " " + lop) != -1);
  ASSERT(strsrch(txt, " " + gop) != -1);
  ASSERT(strsrch(txt, ilop) != -1);
  ASSERT(strsrch(txt, igop) != -1);
  // None of these stores should push an lvalue any more.
  ASSERT(strsrch(txt, llv) == -1);
  ASSERT(strsrch(txt, glv) == -1);
  ASSERT(strsrch(txt, ilv) == -1);
#endif
}

void do_tests() {
  test_local_compound();
  test_local_incdec();
  test_reference_types();
  test_globals();
  test_parameters();
  ASSERT_EQ(16, bump(5));
  test_index_array();
  test_index_mapping();
  test_index_globals();
  test_index_fallback();
  test_unfused_shapes();
  test_inherited_globals();
  test_parameter_index();
  test_mapping_errors();
  test_undefined_incdec();
  test_self_reference();
  test_error_line();
  test_dump_prog();
}
