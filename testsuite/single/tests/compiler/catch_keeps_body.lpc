// Regression: the body of catch(expr) (and acatch(expr) / time_expression(
// expr)) was popped with insert_pop_value() (compiler/internal/trees.cc),
// the same void-context pruning an expression statement gets. That pruning
// deletes "side-effect free" operations -- an index, a range, arithmetic, a
// comparison, a member access, unary minus, a ref read, a function
// constructor's $() captures -- but every one of those can raise an error,
// and raising one is exactly what catch() is asked to observe. catch(s[i])
// compiled to an EMPTY catch and returned 0 for any i, so a test written as
// ASSERT(catch(a[i])) passed whether or not a[i] errors. The same pruning hit
// the left side of a comma and expression statements inside a catch block
// or time_expression (`catch(a[i], 0)`, `catch { a[i]; }`). All of these are
// now evaluated and their value popped; inside such a region only genuinely
// inert values (literals, plain variable reads) are still dropped.
class Pt {
  int x;
}

int calls;

mixed *acatch_results;
mixed *ga = ({ 1, 2, 3 });
int gfive = 5;

// acatch is only legal directly in an async function; with no await the body
// runs to completion synchronously, so the results are there on return.
async void acatch_probe(mixed *a, int five) {
  acatch_results = ({
    acatch { a[five]; },
    acatch(a[five], 0),
    acatch {
      for (int i = 0; i < 1; i++) {
        a[five];
      }
    },
    acatch {
      switch (five) {
        case 5: a[five];
      }
    },
    acatch {
      foreach (int q in ({ 1 })) {
        a[five];
      }
    },
    acatch { a[0]; },
  });
}

void read_ref(int ref r, mixed ref out) {
  out = catch(r);
}

int bump() {
  calls++;
  return 1;
}

void do_tests() {
  string s = "abc";
  mixed *a = ({ 1, 2, 3 });
  int five = 5, zero = 0;
  mixed z = 1;
  mixed ms = "abc", ma = ({ 1 });
  class Pt p;

  ASSERT(catch(s[five]));
  ASSERT(catch(a[five]));
  ASSERT(catch(a[<five]));
  ASSERT(catch(five / zero));
  ASSERT(catch(five % zero));
  ASSERT(catch(z[0..1]));
  ASSERT(catch(p->x));
  // operands typed mixed so the type errors happen at run time
  ASSERT(catch(-ms));
  ASSERT(catch(ms < 1));
  ASSERT(catch(ma + 1));

  // nested in a comma / ternary, and after something with a side effect
  calls = 0;
  ASSERT(catch(bump(), a[five]));
  ASSERT_EQ(1, calls);
  ASSERT(catch(five ? a[five] : 0));

  // the left side of a comma, and statements in a catch block (also inside
  // a loop there)
  ASSERT(catch(a[five], 0));
  ASSERT(catch((a[five], 0), 0));
  ASSERT(catch { a[five]; });
  ASSERT(catch {
    for (int i = 0; i < 1; i++) {
      a[five];
    }
  });
  // a function constructor's $() captures run when it is built
  ASSERT(catch((: $(a[five]) :)));

  // time_expression's block form runs what it is given
  ASSERT(catch(time_expression { a[five]; }));

  // acatch, including inside a loop, switch and foreach there
  acatch_probe(a, five);
  ASSERT_EQ(6, sizeof(acatch_results));
  for (int k = 0; k < 5; k++) {
    ASSERT2(acatch_results[k], "acatch shape " + k + " was pruned");
  }
  ASSERT_EQ(0, acatch_results[5]);

  // a (: :) functional built inside a catch runs later, outside it: its body
  // compiles exactly as it would anywhere else (the unused ga[gfive] is dropped)
  {
    function f;
    catch(f = (: ga[gfive], 7 :));
    ASSERT_EQ(7, evaluate(f));
    f = (: ga[gfive], 7 :);
    ASSERT_EQ(7, evaluate(f));
  }

  // in range: still no error, and still 0
  ASSERT_EQ(0, catch(s[1]));
  ASSERT_EQ(0, catch(a[0] + a[1]));
  ASSERT_EQ(0, catch(five / 1));
  ASSERT_EQ(0, catch(s));
  ASSERT_EQ(0, catch(a[0], s[1]));
  ASSERT_EQ(0, catch { a[0]; });

  // reading a ref whose target is gone raises an error
  {
    mixed out;
    this_object()->read_ref(5, ref out);
    ASSERT(out);
  }
}
