// LPC-level pins for the preprocessor (the unit tests in
// src/tests/test_compiler.cc cover these paths in isolation; this file
// proves them end-to-end through a real object compile).
// Reference: docs/lpc/preprocessor/.

#define STR(x) #x
#define GLUE(a, b) a##b
#define TWICE(x) ((x) + (x))
#define PAIR(a, b) ({ a, b })
#define SELF SELF
#define ML(a) ((a) \
    * 3)

// Documented multi-line function-like form: continuations sit outside
// any literal. A string on a continued line, and two adjacent strings
// joined by a continuation between them, must still be one logical
// directive.
#define LONG_MACRO(x) do { \
    x; \
} while (0)

// Textbook C form: '\' continues the body, and do/while(0) is one
// statement so this `if`/`else` still binds. A block comment between
// continued lines is whitespace, not a new directive.
#define foo(x) do { \
    /* always */ \
    n += (x); \
} while (0)

// gcc-shaped: '\' joins the body; '//' on the last line has no '\'
// so the next line is still compiled.
#define ADD(x, y) do { \
    r += (x); \
    r += (y); \
} while (0) // this comment ends here
#define BAR 10 \
    + 5 // tail, no backslash
#define GREET "hello" \
    " world"
#define INSIDE "hel\
lo"

// C-shaped gaps: comment between '#' and the keyword, glued to the
// keyword, and between continued data lines. Same meaning as today.
# /*c*/ define C_GAP_FOO 1
#define/*c*/ C_GAP_BAR 2
#define C_GAP_BAZ \
    /*c*/ \
    3

// C splice-first: a comment-open may be split by a backslash-newline,
// and a '//' comment continues onto the next physical line.
#define C_SPLICE_STAR 10 /\
* eaten */ + 5
#define C_SPLICE_LINE 1 // note \
this line is not compiled

// Redefining with a different body is a WARNING (non-fatal); the new
// definition takes effect.
#define REDEF 1
#define REDEF 2

#warn preprocessor.lpc exercising #warn -- expected, not a failure

#if defined(FLUFFOS) && defined(__VERSION__)
#define COND_OK 1
#else
#define COND_OK 0
#endif

#if !defined(SURELY_NOT_DEFINED_ANYWHERE)
#define NOTDEF_OK 1
#else
#define NOTDEF_OK 0
#endif

// Token-based #if arithmetic keeps C precedence across macro bodies.
#define ONE_PLUS_ONE 1+1
#if ONE_PLUS_ONE * 2 == 3
#define PRECEDENCE_OK 1
#else
#define PRECEDENCE_OK 0
#endif

// #1236: a block comment opened on a directive line may close on a
// LATER line -- the comment reads as whitespace, it neither ends the
// directive nor leaves its continuation lines to be compiled as code.
#define WARNING_LEVEL 1 /* Change this to higher values to
                           show more warnings. */

// Text after the close on the final line still belongs to the directive.
#define CMT_TAIL 10 /* spans
one line */ + 5

// On a live #if...
#if 1 /* comment on a live #if,
closed here */
#define CMT_IF_OK 1
#else
#define CMT_IF_OK 0
#endif

// ...and on a dead one: the branch below the comment is still skipped.
#if 0 /* opened on the #if line,
closed here */
this is not code and must never be compiled
#endif

// A string literal on the directive line must not open a comment.
#define CMT_STR "a/*b"

// #1382: '//' / '/*' inside a backslash-continued string on a directive
// line is data. The marker plus the continuation are both required; a
// same-line marker or a continuation without one already worked.
#define SLASH_CONT "abc// \
 def"
#define STAR_CONT "abc/* \
 def"
#define TMPL_CONT `abc// \
 def`
#define HEADER_CONT "// made by X.\n// \
Continued line\n// \
final part\n"

// #1240: comments are whitespace in a directive's payload -- a '//'
// tail must NOT be captured into the body (it would comment out the
// rest of whatever spliced line the macro expands into), and trailing
// comments on #ifdef/#undef must not corrupt the name.
#define CREDITS_KEY "credits" // Current number of credits
#define MIN2(x, y) ((x) < (y) ? (x) : (y))

// A body-internal block comment is ONE space: the two '-' below must
// not paste into '--'.
#define DOUBLE_NEG 1 -/*minus*/-1

#ifdef CREDITS_KEY // trailing comment here too
#define IFDEF_CMT_OK 1
#else
#define IFDEF_CMT_OK 0
#endif

#define UNDEF_ME 5
#undef UNDEF_ME // gone

// #1362: comments are whitespace inside an argument LIST too. The macro
// argument collector reads raw characters, so nothing strips comments out
// from under it -- an apostrophe in one ("a guild's") opened a character
// literal that ran to end of file, and a '//' survived into the argument
// text to comment out the rest of it once that text was rescanned.
#define MES(y) ("[" + y + "]")
#define ARG_ID(x) (x)

void do_tests() {
  // ## token paste builds an identifier.
  int GLUE(fo, o) = 42;
  ASSERT_EQ(42, foo);

  // # stringizes the raw argument spelling.
  ASSERT_EQ("hello", STR(hello));
  ASSERT_EQ("1+2", STR(1+2));

  // Function-like expansion; parenthesized body.
  ASSERT_EQ(8, TWICE(4));

  // Commas nested in parentheses do not split arguments.
  ASSERT_EQ(({ ({ 1, 2 }), 3 }), PAIR(({ 1, 2 }), 3));

  // Multi-line (backslash-continued) macro.
  ASSERT_EQ(21, ML(7));
  int long_macro_v = 0;
  LONG_MACRO(long_macro_v = 4);
  ASSERT_EQ(4, long_macro_v);
  int n = 0;
  if (1)
    foo(3);
  else
    foo(99);
  ASSERT_EQ(3, n);
  foo(4);
  ASSERT_EQ(7, n);
  int r = 0;
  ADD(1, 2);
  ASSERT_EQ(3, r);
  ASSERT_EQ(15, BAR);
  ASSERT_EQ("hello world", GREET);
  ASSERT_EQ("hello", INSIDE);
  ASSERT_EQ(1, C_GAP_FOO);
  ASSERT_EQ(2, C_GAP_BAR);
  ASSERT_EQ(3, C_GAP_BAZ);
  ASSERT_EQ(15, C_SPLICE_STAR);
  ASSERT_EQ(1, C_SPLICE_LINE);

  // Self-referencing macro stops expanding at the self-reference, so
  // SELF is usable as an ordinary identifier.
  int SELF = 7;
  ASSERT_EQ(7, SELF);

  // Redefinition took effect (and did not fail the compile).
  ASSERT_EQ(2, REDEF);

  // Conditionals evaluated as expected.
  ASSERT_EQ(1, COND_OK);
  ASSERT_EQ(1, NOTDEF_OK);
  ASSERT_EQ(1, PRECEDENCE_OK);

  // #1236 -- directive-line comments spanning physical lines.
  ASSERT_EQ(1, WARNING_LEVEL);
  ASSERT_EQ(15, CMT_TAIL);
  ASSERT_EQ(1, CMT_IF_OK);
  ASSERT_EQ("a/*b", CMT_STR);
  ASSERT_EQ("abc//  def", SLASH_CONT);
  ASSERT_EQ("abc/*  def", STAR_CONT);
  ASSERT_EQ("abc//  def", TMPL_CONT);
  ASSERT_EQ("// made by X.\n// Continued line\n// final part\n", HEADER_CONT);

  // #1240 -- trailing comments on directives are whitespace.
  mapping economies = ([ "e": ([ "credits": 100 ]) ]);
  ASSERT_EQ(42, MIN2(42, economies["e"][CREDITS_KEY]));
  ASSERT_EQ(2, DOUBLE_NEG);
  ASSERT_EQ(1, IFDEF_CMT_OK);
  int UNDEF_ME = 9;
  ASSERT_EQ(9, UNDEF_ME);

  // #1362 -- comments inside an argument list.
  ASSERT_EQ("[AAA\nBBB\n]", MES("AAA\n" +
    /* a comment with a guild's apostrophe in it */
    "BBB\n"));
  ASSERT_EQ("[AAA\nBBB\n]", MES("AAA\n" +  // another guild's apostrophe
  "BBB\n"));
  ASSERT_EQ("[ab]", MES("a" /* no apostrophe in this one */ + "b"));

  // An apostrophe inside a STRING argument is ordinary text, as ever.
  ASSERT_EQ("[it's]", MES("it's"));

  // A comment is ONE space here too (DOUBLE_NEG above pins the same rule
  // for a macro body), so it separates tokens rather than pasting them.
  // Stringized, because that is the only spelling the corpus formatter is
  // guaranteed not to re-space out from under the pin (see AGENTS.md).
  ASSERT_EQ("a b", STR(a/*sep*/b));

  // A comment may sit between the macro name and its '(' -- that is still
  // an invocation, not a bare identifier.
  ASSERT_EQ("[x]", MES /* why is this here? */ ("x"));

  // Newlines inside an argument-list comment are counted exactly once.
  int line_a = __LINE__;
  ASSERT_EQ(1, ARG_ID(/* one
                         two
                         three */ 1));
  ASSERT_EQ(4, __LINE__ - line_a);

  // Builtin macros: __FILE__ / __DIR__ / __LINE__.
  ASSERT_EQ("/single/tests/compiler/preprocessor.lpc", __FILE__);
  ASSERT_EQ("/single/tests/compiler/", __DIR__);
  ASSERT(__LINE__ > 60);

  // #undef makes the name ordinary again.
#define GONE 5
#undef GONE
  int GONE = 6;
  ASSERT_EQ(6, GONE);
}
