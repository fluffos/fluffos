// A named-function reference with no bound arguments -- `cb`, `(: cb :)`,
// an efun or simul_efun name -- is one value per (object, function) for as
// long as it is alive, so it compares equal to itself however many times it
// is evaluated. Everything that compares function values (==, array set
// operations, member_array, mapping keys) sees the same pointer.
//
// Functionals and pointers with bound arguments are still made fresh by each
// evaluation. A local function keeps its identity across recompile_object()
// when the new program still defines it: the pointer is re-resolved by name.
//
// Fixtures: /clone/named_fn_base.lpc, /clone/named_fn_child.lpc.

#define RELOAD "/data/named_fn_reload"

int add(int a, int b) { return a + b; }
int sub(int a, int b) { return a - b; }

private void test_local() {
  function f = add;
  mixed *inits = ({});
  mapping m = ([]);

  ASSERT(add == add);
  ASSERT(add == (: add :));
  ASSERT(f == add);
  ASSERT(add != sub);

  // The mudlib shape that surfaced this: register and unregister a callback
  // by naming it, with nothing stored in between.
  inits += ({ add });
  inits += ({ sub });
  inits -= ({ add });
  ASSERT_EQ(1, sizeof(inits));
  ASSERT(inits[0] == sub);
  inits -= ({ sub });
  ASSERT_EQ(0, sizeof(inits));

  ASSERT_EQ(1, member_array(sub, ({ add, sub })));
  ASSERT_EQ(({ add }), ({ add, sub }) & ({ add }));

  m[add] = "add";
  ASSERT_EQ("add", m[add]);
  ASSERT_EQ(1, sizeof(m + ([ (: add :): "again" ])));
}

private void test_efun_and_simul() {
  ASSERT(write == write);
  ASSERT(write == (: write :));
  ASSERT(write != (: say :));
  ASSERT(same == same);
  ASSERT(same == (: same :));
}

private void test_not_named() {
  function *made = ({});

  // Bound arguments make a new pointer every time.
  ASSERT((: add, 1 :) != (: add, 1 :));

  // A functional is a new value per evaluation, even from the same source.
  for (int i = 0; i < 2; i++) {
    made += ({ (: $1 + 1 :) });
  }
  ASSERT(made[0] != made[1]);
}

private function local_ref_here() { return add; }

private void test_owners_and_inherits() {
  object a = load_object("/clone/named_fn_child");
  object b = new("/clone/named_fn_child");

  // An inherited function is the same value whether referenced from the
  // program that defines it or from the program that inherits it.
  ASSERT(a->base_ref() == a->child_ref());
  ASSERT(a->local_ref() == a->local_ref());
  ASSERT(a->efun_ref() == a->efun_ref());
  ASSERT(a->bound_ref() != a->bound_ref());

  // The owner is part of the value: the same function in another object is
  // a different pointer, and so is this object's efun pointer.
  ASSERT(a->local_ref() != b->local_ref());
  ASSERT(a->efun_ref() != b->efun_ref());
  ASSERT(a->local_ref() != local_ref_here());

  // bind() makes a copy with a new owner (local-function pointers can't be
  // rebound, efun pointers can); it is not the other object's own reference.
#if efun_defined(bind)
  ASSERT(bind(a->efun_ref(), b) != b->efun_ref());
#endif

  destruct(b);
}

// reclaim_objects() only walks object variables, so the pointers it should
// release have to be held by one.
nosave function *held = ({});

private void test_reclaim() {
#if efun_defined(reclaim_objects)
  // reclaim_objects() drops a destructed owner's ref from the pointers that
  // name it, so it un-interns them first: once the owner can be freed, a new
  // object could reuse its address. The reuse itself can't be forced from
  // here -- destructed objects are only freed by the backend's sweep, after
  // the run -- so this pins what is observable: reclaimed pointers stay out of
  // the way of new owners' references, which stay callable.

  for (int i = 0; i < 8; i++) {
    object o = new("/clone/named_fn_child");
    held += ({ o->local_ref() });
    destruct(o);
  }
  reclaim_objects();
  for (int i = 0; i < 8; i++) {
    object o = new("/clone/named_fn_child");
    function f = o->local_ref();
    ASSERT(member_array(f, held) == -1);
    ASSERT_EQ(2, evaluate(f));
    destruct(o);
  }
  held = ({});
#endif
}

private void write_reload(string body) {
  ASSERT(write_file(RELOAD + ".lpc",
    "inherit \"/clone/named_fn_base\";\n" + body, 1));
}

private void recompile_checks() {
  object ob;
  function local, inherited, stored, gone, bound, functional, efun_fp;
  function *inits;

  write_reload(
    "int tick() { return 1; }\n"
    "int gone() { return 1; }\n"
    "int plus(int n) { return n + 1; }\n"
    "private nosave function stored = tick;\n"
    "function local_ref() { return tick; }\n"
    "function inherited_ref() { return base_fn; }\n"
    "function stored_ref() { return stored; }\n"
    "function gone_ref() { return gone; }\n"
    "function bound_ref() { return (: plus, 10 :); }\n"
    "function functional_ref() { return (: tick() :); }\n"
    "function efun_ref() { return write; }\n");
  ob = load_object(RELOAD);
  local = ob->local_ref();
  inherited = ob->inherited_ref();
  ASSERT(ob->base_ref() == inherited);
  stored = ob->stored_ref();
  gone = ob->gone_ref();
  bound = ob->bound_ref();
  functional = ob->functional_ref();
  efun_fp = ob->efun_ref();
  ASSERT(stored == local);
  inits = ({ local });

  // Functions added before the survivors shift every index, one is removed,
  // and the survivors change behaviour.
  write_reload(
    "int pad() { return 0; }\n"
    "int pad2() { return 0; }\n"
    "int tick() { return 2; }\n"
    "int plus(int n) { return n + 2; }\n"
    "private nosave function stored = tick;\n"
    "function local_ref() { return tick; }\n"
    "function inherited_ref() { return base_fn; }\n"
    "function stored_ref() { return stored; }\n"
    "function bound_ref() { return (: plus, 10 :); }\n"
    "function functional_ref() { return (: tick() :); }\n"
    "function efun_ref() { return write; }\n");
  ASSERT_EQ(1, recompile_object(ob));

  // A named function the new program still has is the same value, now
  // running the new code -- including one held in a carried-over variable,
  // and one registered with a callback list before the recompile.
  ASSERT(ob->local_ref() == local);
  ASSERT(ob->stored_ref() == local);
  ASSERT_EQ(2, evaluate(local));
  inits -= ({ ob->local_ref() });
  ASSERT_EQ(0, sizeof(inits));

  // So is an inherited one, from either program's code.
  ASSERT(ob->inherited_ref() == inherited);
  ASSERT(ob->base_ref() == inherited);
  ASSERT_EQ(1, evaluate(inherited));

  // Bound arguments don't matter to re-resolution; they are refreshed when
  // called.
  ASSERT_EQ(12, evaluate(bound));

  // A removed function stays stale, and a functional is code in the old
  // program, so it is stale too. Efun pointers never depended on the layout.
  ASSERT(catch(evaluate(gone)));
  ASSERT(catch(evaluate(functional)));
  ASSERT(ob->efun_ref() == efun_fp);
}

private void test_recompile() {
#if efun_defined(recompile_object)
  // Clean up even when a check errors, so the generated source never lingers.
  string err = catch(recompile_checks());
  object ob = find_object(RELOAD);

  if (ob) destruct(ob);
  rm(RELOAD + ".lpc");
  if (err) error(err);
#endif
}

void do_tests() {
  test_local();
  test_efun_and_simul();
  test_not_named();
  test_owners_and_inherits();
  test_reclaim();
  test_recompile();
}
