// Generative fuzzer for local-scope accounting in the compiler.
//
// Two bugs in two consecutive review rounds had the same silent signature: a
// construct opened a local scope and did not close it, so the runtime slots of
// a LATER function's parameters shifted while the VM kept pushing arguments at
// 0..n-1. The function compiled cleanly and returned the wrong value. Nothing
// in the testsuite could see that, because a test only notices if the function
// it calls afterwards actually TAKES parameters.
//
// So that is the detector here, applied mechanically: build a source file out
// of a randomly chosen prelude (a global initializer) and body (statements
// inside a function), append a probe function that takes three arguments and
// returns a value encoding all three, compile it, and check the probe answers
// exactly. A shifted slot shows up as a wrong number rather than a diagnostic,
// which is precisely the failure mode a compile-success check misses.
//
// The seed is fixed: a fuzzer in CI has to fail the same way twice.
//
// Every generated file is written under /data (fixtures may not live under
// tests/, which the runner executes wholesale) and removed afterwards.

#include "/include/tests.h"

#define ROUNDS 60
#define GEN_DIR "/data/slotfuzz"

nosave int seed;
nosave int generated;
nosave int compiled;
nosave int with_prelude;
nosave int *fragment_hits;

private int rnd(int n) {
  seed = (seed * 1103515245 + 12345) & 0x3fffffff;
  // Take the HIGH bits. An LCG's low bits have short periods -- bit 0
  // alternates, bit 1 has period 4 -- so `seed % n` for a small n samples
  // exactly the worst part of the state and cycles through a handful of
  // values. The coverage assertion at the end of do_tests() caught this
  // fuzzer reaching 3 of its 12 shapes while otherwise looking perfectly
  // healthy.
  return n > 0 ? (seed >> 15) % n : 0;
}

// Fragments that open a local scope. Each is valid on its own; the point is
// the combinations, and whether whatever opened the scope also closed it.
private string fragment(int which, string suffix) {
  switch (which) {
    case 0:
      return "  mixed e" + suffix + " = catch { int v" + suffix + " = 1; };\n";
    case 1:
      return "  mixed t" + suffix + " = time_expression { int v" + suffix + " = 1; };\n";
    case 2:
      return "  for (int i" + suffix + " = catch { int v" + suffix + " = 1; }; i" + suffix + " < 1; i" + suffix + "++) {\n  }\n";
    case 3:
      return "  switch (1) {\n    case 1: {\n      int q" + suffix + " = 1;\n      break;\n    }\n  }\n";
    case 4:
      return "  foreach (int x" + suffix + " in ({1, 2})) {\n    int y" + suffix + " = x" + suffix + ";\n  }\n";
    case 5:
      return "  {\n    int b" + suffix + " = 1;\n  }\n";
    case 6:
      return "  evaluate(function() { int f" + suffix + " = 1; return f" + suffix + "; });\n";
    case 7:
      return "  evaluate((: 1 + 1 :));\n";
    case 8:
      return "  do {\n    int d" + suffix + " = 1;\n  } while (0);\n";
    case 9:
      return "  if (catch { int c" + suffix + " = 1; }) {\n    int g" + suffix + " = 1;\n  }\n";
    case 10:
      return "  while (0) {\n    int w" + suffix + " = 1;\n  }\n";
    case 11:
      return "  keep = ({ catch { int a" + suffix + " = 1; }, 2 });\n";
  }
  return "";
}

// The same shapes, but written where a GLOBAL initializer can hold them --
// the context with no enclosing function to clean up after it.
private string prelude(int which) {
  switch (which) {
    case 0:
      return "";
    case 1:
      return "mixed gi = catch {\n  int f = 1;\n};\n";
    case 2:
      return "mixed gi = catch {\n  int f = 1;\n  int h = 2;\n};\n";
    case 3:
      return "mixed gi = time_expression {\n  int f = 1;\n};\n";
    case 4:
      return "mixed gi = catch {\n  int f = 1;\n  keep = catch { int inner = 2; };\n};\n";
    case 5:
      return "int gi = 1;\nmixed gj = catch {\n  int f = 1;\n};\n";
  }
  return "";
}

private void run_case(int idx) {
  string path, src, obname;
  object ob;
  mixed err, r;
  int p, f1, f2, nested;

  p = rnd(6);
  f1 = rnd(12);
  f2 = rnd(12);
  nested = rnd(2);

  if (p) {
    with_prelude++;
  }
  fragment_hits[f1] = 1;
  src = "nosave mixed keep;\n" + prelude(p);
  // TWO probes, one before the leaking function and one after: only the
  // function immediately following a leak was affected, so a probe that sat
  // only at the end would miss a leak that an intervening function absorbs,
  // and one only at the front would miss the ordinary case.
  src += "int probe(int a, int b, int c) { return a * 100 + b * 10 + c; }\n";
  src += "int work() {\n";
  src += fragment(f1, "1");
  if (nested) {
    src += fragment(f2, "2");
  }
  src += "  return 1;\n}\n";
  src += "int probe2(int a, int b, int c) { return a * 100 + b * 10 + c; }\n";

  obname = GEN_DIR + "/g" + idx;
  path = obname + ".c";
  write_file(path, src, 1);
  generated++;

  err = catch(ob = load_object(obname));
  if (err) {
    ASSERT2(0, "generated file " + idx + " (prelude " + p + ", fragments " + f1 + "/" +
      (nested ? f2 : -1) + ") failed to compile: " + err);
    rm(path);
    return;
  }
  compiled++;

  r = ob->probe(1, 2, 3);
  ASSERT2(r == 123, "prelude " + p + " fragments " + f1 + "/" + (nested ? f2 : -1) +
    ": probe(1,2,3) returned " + sprintf("%O", r) + " -- argument slots shifted");
  r = ob->probe2(4, 5, 6);
  ASSERT2(r == 456, "prelude " + p + " fragments " + f1 + "/" + (nested ? f2 : -1) +
    ": probe2(4,5,6) returned " + sprintf("%O", r) + " -- argument slots shifted");
  ASSERT_EQ(1, ob->work());

  destruct(ob);
  rm(path);
}

void do_tests() {
  int i;

  seed = 20260818;
  generated = 0;
  compiled = 0;
  with_prelude = 0;
  fragment_hits = allocate(12);

  mkdir(GEN_DIR);
  for (i = 0; i < ROUNDS; i++) {
    run_case(i);
  }
  rmdir(GEN_DIR);

  // Coverage, not behaviour: a generator that silently stops producing
  // loadable files still reports a clean run.
  ASSERT_EQ(ROUNDS, generated);
  ASSERT_EQ(ROUNDS, compiled);
  // The leak that motivated this file only bites when a GLOBAL initializer
  // opens a scope, so a run that never emitted one proves nothing.
  ASSERT2(with_prelude > ROUNDS / 3,
    "only " + with_prelude + " of " + ROUNDS + " cases had a global initializer");
  ASSERT2(sizeof(fragment_hits - ({ 0 })) >= 10,
    "only " + sizeof(fragment_hits - ({ 0 })) + " of 12 scope-opening fragments were generated");
}
