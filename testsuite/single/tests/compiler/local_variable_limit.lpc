// `maximum local variables` must actually be enforced, and its ceiling must
// match what the bytecode can encode.
//
// Every reader spelled the option CFG_INT(__MAX_LOCAL_VARIABLES__), but
// __MAX_LOCAL_VARIABLES__ *is* CFG_INT(9) already -- the double offset
// produced a constant 521, so the option was inert and 521 was everyone's
// effective limit. Local indices are emitted as a single byte
// (icode.cc: ins_byte(F_LOCAL); ins_byte(which)), so 521 was never encodable:
// a function with more than 255 locals compiled, then read or wrote the wrong
// slot at runtime.
//
// The source is generated rather than committed: the point is the boundary,
// and a 300-declaration file is not worth reading.

#include "/include/tests.h"

#define GEN "/data/local_variable_limit"

private string gen(int n) {
  string s = "int probe() {\n";
  int i;

  for (i = 0; i < n; i++) {
    s += "  int v" + i + ";\n";
  }
  for (i = 0; i < n; i++) {
    s += "  v" + i + " = " + i + ";\n";
  }
  return s + "  return v" + (n - 1) + ";\n}\n";
}

private mixed try_locals(int n) {
  mixed err;
  object ob;

  write_file(GEN + ".c", gen(n), 1);
  err = catch(ob = load_object(GEN));
  if (!err && ob) {
    err = catch(ob->probe());
    if (!err) {
      err = ob->probe() == n - 1 ? 0 : "wrong value";
    }
    destruct(ob);
  }
  rm(GEN + ".c");
  return err;
}

void do_tests() {
  // Comfortably inside the byte-index range: compiles and reads back right.
  ASSERT_EQ(0, try_locals(200));

  // Past what a single byte can encode: must be a compile error, not silently
  // truncated indices.
  ASSERT2(try_locals(300) != 0,
    "a function with 300 locals must be rejected -- its indices do not fit in "
    "the byte the bytecode encodes them in");
}
