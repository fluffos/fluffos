// Regression: a range lvalue (x[a..b]) records its indices against the
// owner's size when it is pushed. `x[a..b] &&= rhs` runs the right-hand
// side -- arbitrary LPC -- between that push and the store (a range is never
// false, so &&= always runs it), and an rhs that replaced the owner with a
// shorter value left the store copying with the stale indices:
// assign_lvalue_range() / copy_lvalue_range() overflowed the heap for an
// array or buffer and crashed for a string (pre-existing; master segfaults
// or silently corrupts the heap). The store now re-validates the owner's
// type and size (check_range_lvalue_target) and raises a clean error.
// Surviving with that error, and leaving the new value in place, is the
// regression signal; ASan builds report the overflow on the unfixed driver.
#define CHANGED "*The value indexed by a range lvalue changed before the assignment.\n"

mixed *ga;

void do_tests() {
  mixed *a = allocate(4, 0);
  string s = "abcdefghijklmnopqrstuvwxyz0123456789";
  buffer b = allocate_buffer(64);

  ASSERT_EQ(CHANGED, catch(a[1..3] &&= (a = ({ 1 }), ({ 7, 8, 9 }))));
  ASSERT_EQ(({ 1 }), a);
  ASSERT_EQ(CHANGED, catch(s[1..30] &&= (s = "x", "Q")));
  ASSERT_EQ("x", s);
  ASSERT_EQ(CHANGED, catch(b[1..60] &&= (b = allocate_buffer(1), allocate_buffer(60))));
  ASSERT_EQ(1, sizeof(b));
  // a different type of the same size is refused too
  {
    mixed m = ({ 1, 2, 3 });
    ASSERT_EQ(CHANGED, catch(m[0..1] &&= (m = "xyz", ({ 9 }))));
  }
  // through a global and a longer replacement
  ga = ({ 1, 2, 3 });
  ASSERT_EQ(CHANGED, catch(ga[0..1] &&= (ga = ({ 1, 2, 3, 4, 5 }), ({ 9 }))));

  // unchanged owner: the store happens as before
  a = ({ 1, 2, 3, 4 });
  ASSERT_EQ(({ 9 }), a[1..2] &&= ({ 9 }));
  ASSERT_EQ(({ 1, 9, 4 }), a);
  s = "hello";
  s[0..1] &&= "J";
  ASSERT_EQ("Jllo", s);
  // an owner modified in place to the same size is still written
  a = ({ 1, 2, 3 });
  a[0..0] &&= (a[2] = 7, ({ 5 }));
  ASSERT_EQ(({ 5, 2, 7 }), a);
}
