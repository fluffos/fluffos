// Regression: type-checking a compound assignment whose destination is a
// non-class basic type and whose other side is a class (`c %= 2.5` with
// `class Box c`, which compares float against the class) evaluated
// `compatible[t1] & (1 << t2)` in compatible_types()
// (src/compiler/internal/compiler.cc) with t2 a class type word: t2 is
// TYPE_MOD_CLASS | class index (>= 0x80), so the shift count is >= 128 --
// undefined behaviour that UBSan reports ("shift exponent 128 is too large
// for 32-bit type 'int'") and, with -fno-sanitize-recover, aborts on. Only t1
// was checked for TYPE_MOD_CLASS. The program must still fail to compile
// with a clean type error; surviving the compile is the regression signal on
// a sanitizer build. The source is generated under /data at runtime so the
// fixture never sits in the tests tree.
void do_tests() {
  string path = "/data/compatible_types_class_rhs";

  rm(path + ".lpc");
  write_file(path + ".lpc",
    "class Box { int x; }\n"
    "void f() { class Box c = new(class Box); c %= 2.5; }\n"
    "void g() { class Box c = new(class Box); c *= 1.5; }\n");
  ASSERT(catch(load_object(path)));
  rm(path + ".lpc");

  // compatible_types2() (the symmetric check behind ==, != and ?:) had the
  // same unguarded shift with a class on the right-hand side. Each shape is
  // its own file so one compile error cannot hide the next shift.
  foreach (string e in ({ "2.5 == c", "2.5 != c", "(1 ? 2.5 : c)" })) {
    write_file(path + ".lpc",
      "class Box { int x; }\n"
      "mixed h() { class Box c = new(class Box); return " + e + "; }\n", 1);
    catch(load_object(path));
    rm(path + ".lpc");
  }
}
