int executed = 1;

void test() {
  int h = call_out("test", 0);
  ASSERT_EQ(0, find_call_out(h));
  write(sprintf("callout0: %d\n", executed));
  executed++; ;
}
void do_tests() {
  // the whole point of this crasher: the nesting limit fires from a
  // call_out, i.e. after this file has finished
  master()->expect_deferred_error("Nesting call_out(0) level limit");

  call_out("test", 0.1);
}
